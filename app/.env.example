# Environment — copy to .env.local (never commit)

# Database — Supabase (Settings → Database → Connection string, pooler URI)
DATABASE_URL=

# Supabase API (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SAM.gov (register at https://api.sam.gov/)
SAM_GOV_API_KEY=
SAM_GOV_OPPORTUNITIES_URL=https://api.sam.gov/prod/opportunities/v2/search
SAM_ENTITY_API_BASE=https://api.sam.gov/entity-information/v3/entities

# LLM — Claude primary, Groq fallback
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Object storage — Phase 2 PDF/DOCX export
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Email digest — optional
# RESEND_API_KEY=
DIGEST_EMAIL_TO=bdev@dfeal.com

# SLED connectors — Phase 3
# DEMANDSTAR_USERNAME=
# DEMANDSTAR_PASSWORD=

# Cron secret for /api/cron/* — set same value in cron-job.org Authorization header
CRON_SECRET=change-me-to-a-long-random-string

# Disable Next.js anonymous telemetry (build logs)
NEXT_TELEMETRY_DISABLED=1
