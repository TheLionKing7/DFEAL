# Environment — copy to .env.local (never commit)

# Database — Supabase (Settings → Database → Connection string, pooler URI)
DATABASE_URL=

# Supabase API (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SAM.gov (register at https://api.sam.gov/)
SAM_GOV_API_KEY=
SAM_GOV_OPPORTUNITIES_URL=https://api.sam.gov/prod/opportunities/v2/search
SAM_ENTITY_API_BASE=https://api.sam.gov/entity-information/v3/entities

# LLM — DeepSeek primary, Claude fallback, Groq last resort
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Site URL (magic-link redirects + digest links)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Multi-tenant access -------------------------------------------------------
# Comma-separated emails with platform-admin rights: onboard/suspend firms and
# open any firm's workspace. Access for everyone else comes from firm_members
# (or a firm's auto-join email domains) — there is no global domain allow-list.
PLATFORM_ADMIN_EMAILS=shola@dfeal.com
# 1 = any signed-in user without a firm may onboard their own firm (self-serve SaaS).
# Leave unset/0 for admin-led onboarding.
ALLOW_SELF_SIGNUP=0

# Email digest — Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Smart Capture <digest@yourdomain.com>
# Digest recipients are configured per firm (Firm profile → Daily digest recipients).

# SLED connectors — Phase 3
DEMANDSTAR_USERNAME=
DEMANDSTAR_PASSWORD=
# Optional comma-separated state codes to narrow DemandStar search (e.g. IL,GA). Leave empty for nationwide active bids.
# DEMANDSTAR_STATES=IL
OHIOBUYS_USERNAME=
OHIOBUYS_PASSWORD=
# BONFIRE_PORTALS=https://transitchicago.bonfirehub.com,https://u-46.bonfirehub.com
# Enable SLED ingest in daily cron (Illinois BidBuy, education, Bonfire, Georgia live connectors)
SLED_INGEST_ENABLED=1
# Enable Grants.gov + SBA.gov ingest in daily cron
GRANTS_INGEST_ENABLED=1
# Optional: filter SBA events to a district office slug (e.g. Illinois)
# SBA_DISTRICT_OFFICE=Illinois

# Cron secret for /api/cron/* — set same value in cron-job.org Authorization header
CRON_SECRET=change-me-to-a-long-random-string

# --- Tuning (optional) ---------------------------------------------------------
# LLM_TIMEOUT_MS=90000
# SCORE_LIMIT=1000            # active opportunities scored per firm per run
# SAM_MAX_NAICS_QUERIES=60    # cap on distinct NAICS queried against SAM.gov per run
# LOG_LEVEL=info

# Disable Next.js anonymous telemetry (build logs)
NEXT_TELEMETRY_DISABLED=1

# --- Connectors & integrations ---------------------------------------------
# Encrypts connector secrets (OAuth tokens, webhook secrets, MCP headers).
# Generate with: openssl rand -base64 32   (do NOT change once connectors exist)
CONNECTOR_ENCRYPTION_KEY=
# Google OAuth (Gmail send + Calendar). Redirect URI:
#   https://<your-domain>/api/connectors/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft OAuth (Outlook mail + calendar via Graph). Redirect URI:
#   https://<your-domain>/api/connectors/oauth/microsoft/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
